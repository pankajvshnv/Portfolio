[Unit]
Description=Pankaj Portfolio FastAPI Application
After=network.target

[Service]
Type=simple
# Change to your VPS username (e.g. ubuntu, root, debian)
User=www-data
Group=www-data
WorkingDirectory=/var/www/portfolio
Environment="PATH=/var/www/portfolio/venv/bin"
# Production uvicorn: 2-4 workers, listening on localhost:8000
ExecStart=/var/www/portfolio/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 2

Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
